# ─────────────────────────────────────────────────────────────────────────────
# MCP Aggregator – miljøvariabler
# Kopier til .env og fyll inn verdiene.
# .env er i .gitignore og skal aldri committes.
# ─────────────────────────────────────────────────────────────────────────────


# ── Domene ───────────────────────────────────────────────────────────────────

# Offentlig hostname som Traefik/Coolify eksponerer tjenesten på.
# Lokal test: sett til "localhost" (ingen HTTPS, se merknad under COOKIE_SECURE).
MCP_DOMAIN=mcp.eksempel.no


# ── Hemmelige nøkler ─────────────────────────────────────────────────────────

# Bearer-token for MCP-klienter (Claude Desktop e.l.) og intern proxy-auth.
# Generer: openssl rand -hex 32
ADMIN_TOKEN=

# Signeringsnøkkel for oauth2-proxy sin session-cookie.
# Må være nøyaktig 16, 24 eller 32 bytes (base64-tegn teller som 1 byte hver).
# Generer: openssl rand -base64 24 | tr -d '\n'
COOKIE_SECRET=


# ── GitHub OAuth-app ──────────────────────────────────────────────────────────
# Registrer på: https://github.com/settings/developers → OAuth Apps → New
#
# Produksjon:  callback URL = https://<MCP_DOMAIN>/oauth2/callback
# Lokal test:  callback URL = http://localhost:4180/oauth2/callback
#              (opprett en separat test-app på GitHub)

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Kommaseparert liste med GitHub-brukernavn som får tilgang.
# IKKE la stå tom – da blokkeres alle.
GITHUB_ALLOWED_USERS=ditt-brukernavn


# ── Valgfritt ─────────────────────────────────────────────────────────────────

# Loggnivå for aggregatoren: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Tillat alle e-postdomener (GitHub-brukernavn brukes for tilgangskontroll, ikke e-post)
OAUTH2_PROXY_EMAIL_DOMAINS=*

# Fjern kommentar ved lokal test uten HTTPS (oauth2-proxy krever ellers sikker cookie)
#OAUTH2_PROXY_COOKIE_SECURE=false
