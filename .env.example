# Domain that Traefik exposes (must match your GitHub App callback root)
MCP_DOMAIN=mcp.example.com

# Secret key for signed admin session cookies — generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-in-production

# GitHub OAuth App credentials
# Register at: https://github.com/settings/developers → OAuth Apps
# Homepage URL:                https://<MCP_DOMAIN>
# Authorization callback URL:  https://<MCP_DOMAIN>/oauth/callback
#   (shared by admin browser login and MCP client OAuth flow)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated list of GitHub usernames allowed to authenticate
GITHUB_ALLOWED_USERS=your-github-username

# Comma-separated subset of GITHUB_ALLOWED_USERS with admin rights (can see
# and manage every server, override visibility). Optional — leave empty for
# no admins.
ADMIN_USERS=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
